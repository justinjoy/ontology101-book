% ============================================================
% Sudoku in ASP (clingo 5.x+)
% ------------------------------------------------------------
% 모델링 개요:
% - cell(R,C,N): R행 C열 칸에 숫자 N이 배치됨을 의미합니다.
% - 각 칸에는 정확히 하나의 숫자가 들어가야 하며,
%   행, 열, 그리고 3x3 박스 내에서는 동일 숫자가 두 번 이상 등장할 수 없습니다.
% - given(R,C,N): 퍼즐에 미리 주어진 숫자(기보)입니다.
% ============================================================

% ---------- 도메인 ----------
row(1..9).             % 행 번호 1~9
col(1..9).             % 열 번호 1~9
num(1..9).             % 가능한 숫자 1~9

% ---------- 각 칸은 정확히 하나의 숫자 ----------
% 의미: 각 행 R, 열 C의 칸에는 1부터 9까지 숫자 중 오직 하나만 선택됩니다.
1 { cell(R,C,N) : num(N) } 1 :- row(R), col(C).

% ---------- 기보(주어진 퍼즐 값) 처리 ----------
% 의미: 퍼즐에서 주어진 값이 있다면 그 칸은 반드시 그 값으로 채워져야 합니다.
cell(R,C,N) :- given(R,C,N).

% 의미: 주어진 칸에는 그 값 이외의 다른 숫자가 들어가면 안 됩니다.
:- given(R,C,N1), cell(R,C,N2), N1 != N2.

% ---------- 행 제약 ----------
% 의미: 같은 행 R 안에서는 숫자 N이 두 번 이상 나타나면 안 됩니다.
:- row(R), num(N), 2 { cell(R,C,N) : col(C) }.

% ---------- 열 제약 ----------
% 의미: 같은 열 C 안에서는 숫자 N이 두 번 이상 나타나면 안 됩니다.
:- col(C), num(N), 2 { cell(R2,C,N) : row(R2) }.

% ---------- 3x3 박스 제약 ----------
% 의미: 같은 3x3 박스 안에서도 숫자 N이 두 번 이상 나타나면 안 됩니다.
%       (R-1)/3과 (C-1)/3을 이용하여 각 칸이 속한 박스를 계산합니다.
:- num(N), BR=0..2, BC=0..2,
   2 { cell(R,C,N) :
       row(R), col(C),
       (R-1)/3 = BR, (C-1)/3 = BC }.

% ---------- 선택적 대칭성 줄이기 ----------
% 의미: 첫 번째 칸을 1로 고정하면 동일한 구조의 해를 일부 제거해 탐색 속도를 높일 수 있습니다.
% { cell(1,1,1) }.
% :- not cell(1,1,1).

% ---------- 출력 ----------
% 의미: 해답으로 cell(R,C,N) 형태의 배치만 출력합니다.
#show cell/3.
